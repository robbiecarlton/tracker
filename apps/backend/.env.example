# Copy to .env for local development. Every var has a dev-friendly default in
# src/env.ts, so an empty .env still boots.

# development | test | production
NODE_ENV=development

# Port the Fastify server listens on
PORT=4000

# Database. Local dev + tests use PGlite (in-process, no server):
#   pglite://./.data/dev      -> on-disk, persists between runs
#   pglite://memory://        -> in-memory, wiped each run
# Production uses hosted Postgres:
#   postgres://user:pass@host:5432/tracker
DATABASE_URL=pglite://./.data/dev

# Better Auth. Generate a real secret for anything shared: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:4000

# Origin of the web app, for CORS + Better Auth trusted origins
WEB_ORIGIN=http://localhost:8081
