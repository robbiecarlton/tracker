{
  "name": "@tracker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API for the habit tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "node scripts/new-migration.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "db:reset": "rimraf .data && npm run db:migrate"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.4",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@tracker/core": "*",
    "better-auth": "1.7.4",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tracker/config": "*",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.37.0",
    "rimraf": "6.1.3",
    "tsup": "^8.5.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
